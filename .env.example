NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — enquiry delivery
RESEND_API_KEY=
RFQ_TO_EMAIL=soumith@arivoglobal.com
RFQ_FROM_EMAIL=

# Vercel Blob — drawing / specification uploads
BLOB_READ_WRITE_TOKEN=

# Canonical origin for sitemap, canonical tags and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.arivoglobal.com
